<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ResumePoint</RootNamespace>
    <AssemblyName>ResumePoint</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ResumePoint.ico</ApplicationIcon>
    <Product>ResumePoint</Product>
    <AssemblyTitle>ResumePoint 断点续播伴生工具</AssemblyTitle>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>Local</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标用多尺寸 ico（由 tools\Generate-Icon.ps1 生成），同时也是 exe 的应用图标 -->
    <None Include="ResumePoint.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ResumePoint.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
